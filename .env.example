# ==== Telegram ====
BOT_TOKEN=123456:PUT_YOUR_BOT_TOKEN_HERE
ADMIN_IDS=123456789,987654321

# ==== AI ====
DEEPSEEK_API_KEY=sk-put-your-deepseek-key-here
AI_MAX_REPLY_LENGTH=1000

# ==== База данных ====
# По умолчанию база создаётся в постоянном каталоге DATA_DIR (на bothost это /app/data),
# поэтому при обновлении из Git она не теряется. Строку ниже можно не задавать.
# DATABASE_URL=sqlite+aiosqlite:////app/data/vellio_bot.db

# ==== Шифрование ключей маркетплейсов (Fernet) ====
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ==== ЮKassa ====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
